# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_N8N_URL=http://localhost:5679

# Shared secret for n8n → Next.js pipeline routes (header: x-ingest-secret)
INGEST_SECRET=dev-insightloop-secret

# --- Postgres (app + shared Docker service) ---
POSTGRES_USER=airn
POSTGRES_PASSWORD=airn_dev_password
POSTGRES_DB=ai_research_newsletter
POSTGRES_PORT=5433
DATABASE_URL=postgresql://airn:airn_dev_password@localhost:5433/ai_research_newsletter

# --- n8n (local Docker; uses its own SQLite volume) ---
N8N_PORT=5679
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5679/
N8N_EDITOR_BASE_URL=http://localhost:5679/
N8N_ENCRYPTION_KEY=dev-only-change-me-in-prod
TZ=Europe/Belgrade

# --- LLM (Phase 3+) ---
GROQ_API_KEY_NEWSLETTER=
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram ---
# Bot token from @BotFather. Readers link their own chat in Settings → Connect Telegram.
TELEGRAM_BOT_TOKEN=
# Optional: skips a getMe call when building t.me deep links (without the @).
TELEGRAM_BOT_USERNAME=
# Production only: secret for /api/telegram/webhook (header x-telegram-bot-api-secret-token).
# Locally, "Check connection" polls getUpdates instead.
TELEGRAM_WEBHOOK_SECRET=
# Optional bootstrap: the first registered account (admin) starts linked to this chat.
TELEGRAM_CHAT_ID=
